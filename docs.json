{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "xDNA Labs",
  "description": "DNA-based data storage — decentralized, permanent, biological.",
  "colors": {
    "primary": "#24db9b",
    "light": "#24db9b",
    "dark": "#00af72"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index"]
          },
          {
            "group": "Why DNA",
            "pages": [
              "why-dna/storage-properties",
              "why-dna/writing",
              "why-dna/reading",
              "why-dna/storing",
              "why-dna/in-dna-compute"
            ]
          },
          {
            "group": "Industry Impact",
            "pages": [
              "industry-impact/benefits",
              "industry-impact/desci-and-biotech",
              "industry-impact/blockchain-integration",
              "industry-impact/ai-integration",
              "industry-impact/scalability"
            ]
          },
          {
            "group": "Token",
            "pages": ["tokenomics"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Twitter",
          "href": "https://x.com/xdnalabs",
          "icon": "square-x-twitter"
        },
        {
          "anchor": "Telegram",
          "href": "https://t.me/xdnalabs",
          "icon": "telegram"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#F2F2F2",
      "dark": "#070908"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Buy $DNA",
        "href": "https://www.xdnalabs.com/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start Storing",
      "href": "https://www.xdnalabs.com/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/xdnalabs",
      "telegram": "https://t.me/xdnalabs"
    }
  }
}
