{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "xDNA Labs",
  "description": "Privacy enforced at OS level system level",
  "colors": {
    "primary": "#d6d5da",
    "light": "#d6d5da",
    "dark": "#3d3c41"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/images/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": ["index", "get-started/privacy-enforcement"]
          },
          {
            "group": "How It Works",
            "pages": [
              "architecture/overview",
              "architecture/secure-execution",
              "architecture/session-isolation",
              "architecture/session-model"
            ]
          },
          {
            "group": "Built-in Modules",
            "pages": [
              "modules/browser",
              "modules/messenger",
              "modules/ops-ai",
              "modules/route"
            ]
          },
          {
            "group": "Token & FAQ",
            "pages": ["tokenomics", "faq"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Twitter",
          "href": "https://x.com/blckops",
          "icon": "square-x-twitter"
        },
        {
          "anchor": "Telegram",
          "href": "https://t.me/blckops",
          "icon": "telegram"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "background": {
    "decoration": "windows",
    "color": {
      "light": "#F2F2F2",
      "dark": "#070709"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Buy $OPS",
        "href": "http://blackops-theta.vercel.app/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download OS",
      "href": "http://blackops-theta.vercel.app/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/blckops",
      "telegram": "https://t.me/blckops"
    }
  }
}
